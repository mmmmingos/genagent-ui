{
  "name": "genui-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A generative-UI wrapper over real Claude Code, Codex and Grok sessions",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/unit.test.mjs",
    "setup": "node scripts/install.mjs",
    "test:e2e": "node tests/e2e-backend.mjs",
    "test:flow": "node tests/e2e-flow.mjs",
    "test:ui": "node tests/ui-journey.mjs && node tests/ui-agent.mjs && node tests/ui-drive.mjs && node tests/ui-newgoal.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "morphdom": "^2.7.8",
    "ws": "^8.22.1"
  }
}
